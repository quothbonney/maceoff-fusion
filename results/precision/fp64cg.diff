+++ b/flashTP_e3nn/cg_table.py
@@ -0,0 +1,39 @@
+"""CG value table helpers (exp/fp64-cg).
+
+Upstream rounds every CG value to fp32 before deduplication, so in fp64 mode the
+kernel's (double) constant-memory CG table only holds fp32-accurate values.
+Here values are kept in the target dtype and deduplicated with a tolerance.
+For fp32 the upstream behaviour (round to fp32, exact dedupe) is unchanged.
+"""
+import torch
+
+# wigner_3j fp64 values that are mathematically equal differ by a few ulp
+CG_DEDUP_ATOL = {torch.float64: 1e-12}
+
+
+def build_unique_cg(values, dtype):
+    """values: iterable of python floats / 0-d tensors in fp64. Returns sorted list of representatives."""
+    if dtype != torch.float64:
+        return list(set(float(torch.tensor(v, dtype=torch.float64).to(torch.float32).to(dtype)) for v in values))
+    tol = CG_DEDUP_ATOL[dtype]
+    vals = sorted(float(v) for v in values)
+    reps = []
+    for v in vals:
+        if reps and abs(v - reps[-1][0]) <= tol:
+            reps[-1][1].append(v)
+        else:
+            reps.append([v, [v]])
+    # representative: first member (all members agree within tol)
+    return [r[0] for r in reps]
+
+
+def cg_index(unique_cg_val, value, dtype):
+    """index of the table entry representing `value` (fp64 tensor/float)."""
+    v = float(value)
+    if dtype != torch.float64:
+        return unique_cg_val.index(float(torch.tensor(v, dtype=torch.float64).to(torch.float32).to(dtype)))
+    tol = CG_DEDUP_ATOL[dtype]
+    best = min(range(len(unique_cg_val)), key=lambda i: abs(unique_cg_val[i] - v))
+    if abs(unique_cg_val[best] - v) > tol:
+        raise ValueError(f"CG value {v!r} not in table")
+    return best
